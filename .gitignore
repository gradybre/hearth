# ─────────────────────────────────────────────────────────────
# Secrets — see HEARTH_SPEC.md §8.6. Nothing with a real key
# ever lands in this repo. Keep .env.example committed as a
# template with key NAMES only and empty values.
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.env

# Keys, certs, service-account files
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
key.properties
secrets.json
service-account*.json

# Supabase local state (may contain generated keys)
.supabase/
supabase/.branches/
supabase/.temp/
supabase/functions/**/.env

# ─────────────────────────────────────────────────────────────
# Flutter / Dart
# ─────────────────────────────────────────────────────────────
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
.flutter-versions
*.lock.bak
coverage/
doc/api/
*.g.dart.bak

# Drift / generated code caches
*.moor.dart.bak

# Test output
test/failures/
**/failures/
*.log

