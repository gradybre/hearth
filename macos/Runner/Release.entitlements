<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Supabase, Open Food Facts and USDA are all reached over the network.
	     Without this the sandbox blocks every outbound request, so the app
	     runs and quietly finds nothing. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Scanning a barcode with the Mac's camera (spec §5.5). -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Choosing a recipe photo opens a file dialog; the sandbox needs to be
	     told the user may hand us the file they picked. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
</dict>
</plist>
