# Template only — key NAMES, never real values. Copy to .env.local and fill in there.
# .env.local is gitignored. See docs/HEARTH_SPEC.md §8.1 / §8.6.

# ── Client-safe (ships in the app bundle; RLS is the boundary) ──
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ── Server-only (Edge Function secrets via `supabase secrets set`).
#    NEVER put real values of these in any file in this repo. ──
# SUPABASE_SECRET_KEY=
# ANTHROPIC_API_KEY=
# USDA_FDC_API_KEY=
